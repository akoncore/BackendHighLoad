  {
   "id": "pc0024",
   "type": "text",
   "x": 777.7199999999999,
   "y": 1024.0,
   "width": 168.16,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
