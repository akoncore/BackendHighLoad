   "link": null,
   "locked": false,
   "text": "Product (~2 KB)\n1. id uuid - 16B\n2. title varchar(200) - 200B\n3. description text - ~1 KB\n4. price numeric(12,2) - 8B\n5. currency char(3) - 3B\n6. brand_id int - 4B\n7. category_id int fk - 4B\n8. attributes jsonb - ~500B\n9. image_urls text[] - ~300B\n10. stock int - 4B\n11. version int - 4B\n12. updated_at timestamptz - 8B\n\nCategory\n1. id int - 4B\n2. name varchar(100) - 100B\n3. parent_id int - 4B",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Product (~2 KB)\n1. id uuid - 16B\n2. title varchar(200) - 200B\n3. description text - ~1 KB\n4. price numeric(12,2) - 8B\n5. currency char(3) - 3B\n6. brand_id int - 4B\n7. category_id int fk - 4B\n8. attributes jsonb - ~500B\n9. image_urls text[] - ~300B\n10. stock int - 4B\n11. version int - 4B\n12. updated_at timestamptz - 8B\n\nCategory\n1. id int - 4B\n2. name varchar(100) - 100B\n3. parent_id int - 4B",
   "autoResize": true,
   "lineHeight": 1.25
  },
