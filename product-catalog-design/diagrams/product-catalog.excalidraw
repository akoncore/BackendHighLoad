  {
   "id": "pc0010",
   "type": "text",
   "x": 1117.84,
   "y": 62,
   "width": 742.7199999999999,
   "height": 315.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
