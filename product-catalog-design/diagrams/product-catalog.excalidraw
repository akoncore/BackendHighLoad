  {
   "id": "pc0034",
   "type": "text",
   "x": 756.8399999999999,
   "y": 1487.0,
   "width": 599.0799999999999,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aX",
   "roundness": null,
   "seed": 506770418,
   "version": 1,
   "versionNonce": 578087449,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1771057311960,
   "link": null,
   "locked": false,
   "text": "Monitoring: hit ratio, p50 / p99, error rate,\n  ES indexing lag, Kafka consumer lag, DB replica lag\nIndexes: (category_id, price), covering INCLUDE (title),\n  check with EXPLAIN (ANALYZE, BUFFERS)\nLimits: rate limit on API GW (per IP / token),\n  request timeouts, query size caps\nSecurity: JWT + RBAC for write endpoints, input validation",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Monitoring: hit ratio, p50 / p99, error rate,\n  ES indexing lag, Kafka consumer lag, DB replica lag\nIndexes: (category_id, price), covering INCLUDE (title),\n  check with EXPLAIN (ANALYZE, BUFFERS)\nLimits: rate limit on API GW (per IP / token),\n  request timeouts, query size caps\nSecurity: JWT + RBAC for write endpoints, input validation",
   "autoResize": true,
   "lineHeight": 1.25
  },
