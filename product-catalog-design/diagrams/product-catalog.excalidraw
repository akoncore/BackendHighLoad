   "text": "Trade-offs",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Trade-offs",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "pc0031",
   "type": "text",
   "x": 20,
   "y": 1487.0,
   "width": 629.8599999999999,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aU",
   "roundness": null,
   "seed": 1446943726,
   "version": 1,
   "versionNonce": 374281492,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1771057311960,
   "link": null,
   "locked": false,
   "text": "PostgreSQL, not Cassandra: 2 GB, relational, 20 write RPS\nElasticsearch, not SQL LIKE: filters, facets, relevance\nCache-aside, not write-through: reads dominate, hot data only\nOutbox + Kafka, not dual write: atomic, no lost updates\nKeyset (cursor) paging, not OFFSET: stable and fast\nDEL on write, not SET: avoids the stale-write race\nREST + JSON on public API: CDN caching, any client",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PostgreSQL, not Cassandra: 2 GB, relational, 20 write RPS\nElasticsearch, not SQL LIKE: filters, facets, relevance\nCache-aside, not write-through: reads dominate, hot data only\nOutbox + Kafka, not dual write: atomic, no lost updates\nKeyset (cursor) paging, not OFFSET: stable and fast\nDEL on write, not SET: avoids the stale-write race\nREST + JSON on public API: CDN caching, any client",
   "autoResize": true,
   "lineHeight": 1.25
  },
