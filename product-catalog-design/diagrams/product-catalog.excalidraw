   "updated": 1771057311960,
   "link": null,
   "locked": false,
   "text": "Read path:  Client -> CDN -> API GW -> Product Service -> L1 -> Redis -> PostgreSQL replica (only if all miss)\nWrite path: Seller -> API GW -> Write Service -> PostgreSQL primary + outbox -> Kafka -> Indexer\nImage upload: Write Service returns a presigned URL, client uploads straight to S3, CDN serves it",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Read path:  Client -> CDN -> API GW -> Product Service -> L1 -> Redis -> PostgreSQL replica (only if all miss)\nWrite path: Seller -> API GW -> Write Service -> PostgreSQL primary + outbox -> Kafka -> Indexer\nImage upload: Write Service returns a presigned URL, client uploads straight to S3, CDN serves it",
   "autoResize": true,
   "lineHeight": 1.25
  }
