   "seed": 255770068,
   "version": 1,
   "versionNonce": 153127526,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1771057311960,
   "link": null,
   "locked": false,
   "text": "GET    /api/v1/products/{id}            -> 200 Product | 404\nGET    /api/v1/categories/{id}/products\n       ?cursor=&limit=                  -> {items, next_cursor}\nGET    /api/v1/search?q=&brand=&price_min=&price_max=\n       &sort=&cursor=                   -> {items, next_cursor}\nPOST   /api/v1/products\n       Idempotency-Key: <uuid>          -> 201 Created\nPUT    /api/v1/products/{id}\n       If-Match: <version>              -> 200 | 412 Precondition Failed\nDELETE /api/v1/products/{id}            -> 204\nPOST   /api/v1/products/{id}/images     -> presigned S3 URL\nPOST   /api/v1/products/{id}/images/confirm -> 200\n\nAuth: public GET; write endpoints need JWT + role (admin/seller)",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GET    /api/v1/products/{id}            -> 200 Product | 404\nGET    /api/v1/categories/{id}/products\n       ?cursor=&limit=                  -> {items, next_cursor}\nGET    /api/v1/search?q=&brand=&price_min=&price_max=\n       &sort=&cursor=                   -> {items, next_cursor}\nPOST   /api/v1/products\n       Idempotency-Key: <uuid>          -> 201 Created\nPUT    /api/v1/products/{id}\n       If-Match: <version>              -> 200 | 412 Precondition Failed\nDELETE /api/v1/products/{id}            -> 204\nPOST   /api/v1/products/{id}/images     -> presigned S3 URL\nPOST   /api/v1/products/{id}/images/confirm -> 200\n\nAuth: public GET; write endpoints need JWT + role (admin/seller)",
   "autoResize": true,
   "lineHeight": 1.25
  },
