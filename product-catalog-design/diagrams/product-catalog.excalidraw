   "boundElements": [],
   "updated": 1771057311960,
   "link": null,
   "locked": false,
   "text": "FR:\n1. View a product card by id\n2. Browse products by category (pagination)\n3. Search with filters (text, brand, price, attributes)\n4. Admin / seller creates, updates, deletes products\n\nNFR:\n1. 10,000 RPS reads / 20 RPS writes (read-heavy, 500:1)\n2. 1M products\n3. p99 latency < 80 ms\n4. Eventual consistency is OK (seconds)\n5. High availability 99.9%+ (multi-AZ)",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FR:\n1. View a product card by id\n2. Browse products by category (pagination)\n3. Search with filters (text, brand, price, attributes)\n4. Admin / seller creates, updates, deletes products\n\nNFR:\n1. 10,000 RPS reads / 20 RPS writes (read-heavy, 500:1)\n2. 1M products\n3. p99 latency < 80 ms\n4. Eventual consistency is OK (seconds)\n5. High availability 99.9%+ (multi-AZ)",
   "autoResize": true,
   "lineHeight": 1.25
  },
